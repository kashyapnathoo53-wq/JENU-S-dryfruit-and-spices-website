# ==============================================================
# JENU'S DRYFRUIT & SPICES - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================

# --- 1. FRONTEND ENVIRONMENT VARIABLES (Vite / Cloudflare Pages / Vercel) ---
VITE_RAZORPAY_KEY_ID=rzp_test_Tf36riXXdeFssw
VITE_MERCHANT_NAME=JENU'S Kashmir Gourmet
VITE_FSSAI_LICENSE=10026061000412
# Set VITE_API_URL if frontend and backend are hosted on different domains in production:
# VITE_API_URL=https://jenus-api.onrender.com/api

# --- 2. BACKEND ENVIRONMENT VARIABLES (Render / Supabase / Railway) ---
# Database Connection:
# For Supabase PostgreSQL, paste your Connection Pooler URI (Session or Transaction mode):
# postgresql://postgres.[project-ref]:[db-password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///jenus_kashmir.db

# Flask Application Security:
FLASK_ENV=production
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string
JWT_SECRET_KEY=change-me-to-a-secure-jwt-secret-key-phrase

# Initial Super-Admin Account (Created automatically by seed script if not present):
ADMIN_EMAIL=admin@jenus.com
ADMIN_PASSWORD=KashmirValley2026!Secure

# Razorpay Payment Gateway (Server-Side Secrets - NEVER commit or share):
RAZORPAY_KEY_ID=rzp_test_Tf36riXXdeFssw
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_from_razorpay_dashboard
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_optional

# CORS Security (Comma-separated list of allowed frontend origins):
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://jenus-kashmir.pages.dev
